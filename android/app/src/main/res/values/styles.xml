<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Launch theme (pre–Android 12 uses windowBackground; API 31+ see values-v31). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Normal theme -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <style name="FocusBlockedTheme" parent="@android:style/Theme.Light.NoTitleBar.Fullscreen">
        <!-- Opaque canvas so the window is never a transparent/white flash while
             the native overlay inflates. Must match FocusBlockedActivity light bg. -->
        <item name="android:windowBackground">#F7F5F0</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <style name="PrayerAlarmTheme" parent="@android:style/Theme.Light.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">#F7F5F0</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

</resources>

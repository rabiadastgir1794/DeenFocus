// Meta / Facebook and TikTok App Events secrets — DO NOT COMMIT real values.
// Copy to MetaSecrets.xcconfig (gitignored) or set in CI.

// Meta / Facebook credentials (required for Meta iOS SDK)
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=
FACEBOOK_DISPLAY_NAME=Deen Focus

// TikTok credentials (optional - loaded via dart-defines at runtime)
// If you want to initialize TikTok early in AppDelegate, add these here
// Otherwise, they can be provided only in dart_defines.json
TIKTOK_APP_ID=com.rnr.deenfocus
TIKTOK_TT_APP_ID=
TIKTOK_APP_SECRET=
